# --- Supabase (apps/web) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Nunca prefijar con NEXT_PUBLIC_. Usado en Route Handlers/Server Actions y por el worker.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta / WhatsApp Cloud API (server-only, NUNCA NEXT_PUBLIC_) ---
# Token de sistema del WABA. En producción se guarda cifrado en waba_accounts;
# esta variable solo se usa para el seed inicial / desarrollo local.
META_WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Clave usada para cifrar/descifrar el access token guardado en waba_accounts (pgsodium/app-level AES-GCM)
WABA_TOKEN_ENCRYPTION_KEY=

# --- Redis / BullMQ (apps/worker y apps/web para encolar) ---
REDIS_URL=redis://localhost:6379

# --- General ---
NODE_ENV=development
